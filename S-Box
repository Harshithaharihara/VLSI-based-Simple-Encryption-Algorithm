module sbox(
    input  [3:0] in,
    output [3:0] out
);
    reg [3:0] lut [0:15];
    initial begin
        lut[0]  = 4'hE; lut[1]  = 4'h4; lut[2]  = 4'hD; lut[3]  = 4'h1;
        lut[4]  = 4'h2; lut[5]  = 4'hF; lut[6]  = 4'hB; lut[7]  = 4'h8;
        lut[8]  = 4'h3; lut[9]  = 4'hA; lut[10] = 4'h6; lut[11] = 4'hC;
        lut[12] = 4'h5; lut[13] = 4'h9; lut[14] = 4'h0; lut[15] = 4'h7;
    end
    assign out = lut[in];
endmodule

