module vlsi_encryption(
    input        clk,
    input        rst,
    input        enc_dec,       // 1 = encrypt, 0 = decrypt
    input  [7:0] data_in,
    input  [7:0] key,
    output reg [7:0] data_out,
    output reg       valid
);
    wire [7:0] enc_out, dec_out;

    encrypt_core enc (.plaintext(data_in), .key(key), .ciphertext(enc_out));
    decrypt_core dec (.ciphertext(data_in), .key(key), .plaintext(dec_out));

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            data_out <= 8'h00;
            valid    <= 1'b0;
        end else begin
            data_out <= enc_dec ? enc_out : dec_out;
            valid    <= 1'b1;
        end
    end
endmodule

