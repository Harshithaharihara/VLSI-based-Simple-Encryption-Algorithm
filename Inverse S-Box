module sbox_inv(
    input  [3:0] in,
    output [3:0] out
);
    reg [3:0] lut [0:15];
    initial begin
        lut[4'hE]=4'h0; lut[4'h4]=4'h1; lut[4'hD]=4'h2; lut[4'h1]=4'h3;
        lut[4'h2]=4'h4; lut[4'hF]=4'h5; lut[4'hB]=4'h6; lut[4'h8]=4'h7;
        lut[4'h3]=4'h8; lut[4'hA]=4'h9; lut[4'h6]=4'hA; lut[4'hC]=4'hB;
        lut[4'h5]=4'hC; lut[4'h9]=4'hD; lut[4'h0]=4'hE; lut[4'h7]=4'hF;
    end
    assign out = lut[in];
endmodule
